# ─── Application ──────────────────────────────────────────────
APP_NAME=HireAI
APP_ENV=development
DEBUG=true
PORT=8000
USE_REDIS=false

# ─── Database (AWS RDS PostgreSQL) ────────────────────────────
# Format: postgresql://username:password@host:5432/dbname
DATABASE_URL=postgresql://hireai:yourpassword@your-rds-endpoint.rds.amazonaws.com:5432/hireai

# ─── AWS Cognito ──────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if your app client has a secret configured
COGNITO_CLIENT_SECRET=

# ─── JWT ──────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ─── Redis (AWS ElastiCache or local) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AWS General ──────────────────────────────────────────────
AWS_REGION=ap-south-1

# LOCAL DEV ONLY — on ECS the task IAM role handles credentials automatically
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── AWS S3 ───────────────────────────────────────────────────
AWS_S3_BUCKET=hireai-uploads-prod

# ─── Email — Resend SMTP ───────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002

# ─── Interview Settings ───────────────────────────────────────
MATCH_THRESHOLD=0.20
INTERVIEW_ROOM_EXPIRY=7200
MAX_INTERVIEW_DURATION=5400

# ─── Candidate Verification ───────────────────────────────────
# Minimum score (0-100) for a candidate to receive the Verified badge
# VERIFICATION_PASS_THRESHOLD=40  (set in verification.py, override here if needed)
